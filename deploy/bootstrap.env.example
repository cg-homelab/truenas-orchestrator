# bootstrap.env: inputs for deploy/bootstrap.sh and docs/hand-install.md.
#
# Copy to bootstrap.env next to bootstrap.sh (the default path; --env FILE picks another) and edit.
# Plain KEY=VALUE lines only: the file is parsed, never sourced, so no spaces around "=" and no command
# substitution.
#
# The storage roots and PUID/PGID must equal the values in the homelab repo's compose/.global.env.
# Bootstrap writes .global.env from compose/example.global.env when it is absent, and stops if an existing
# one disagrees (it never edits it).

# Storage roots: absolute paths below /mnt/<pool>/, distinct, none inside another. MEDIA_STORAGE must
# exist before the orchestrator app is installed (B13); bootstrap never creates it.
HOMELAB_STORAGE=/mnt/tank/apps/homelab
APPCONFIG_STORAGE=/mnt/tank/apps/appconfigs
DATABASE_STORAGE=/mnt/tank/databases
MEDIA_STORAGE=/mnt/tank/media

# The orchestrator's own state dataset (SQLite database, deploy key, TrueNAS CA file). D10.
ORCH_STATE_STORAGE=/mnt/tank/apps/orchestrator

# The one homelab identity (D32): containers and the orchestrator run as PUID:PGID. Never 0 or 950.
# PUID must be 1000 in M4: the published orchestrator image has a passwd entry only for uid 1000, and
# ssh (git fetch with the deploy key) needs one for the uid it runs as. Images that run as any uid are
# a follow-up. PGID: a new group needs a gid in 1000-2999; an existing group holding it is accepted.
PUID=1000
PGID=1000

# The homelab git repository, cloned into HOMELAB_STORAGE with the deploy key bootstrap generates.
# Use the SSH URL; a URL with embedded credentials (https://user:token@...) is refused.
REPO_URL=git@github.com:example/homelab.git

# The orchestrator image for its TrueNAS custom app.
ORCH_IMAGE=ghcr.io/cg-homelab/truenas-orchestrator:0.4.0

# Optional. The name of the orchestrator's TrueNAS app (default truenas-orchestrator).
ORCH_APP_NAME=truenas-orchestrator

# Optional. The TrueNAS user that owns the orchestrator's API key (default truenas_admin).
TRUENAS_API_USER=truenas_admin
