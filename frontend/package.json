	},
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.5"
	}
}
